# Copiez ce fichier en ".env" pour le développement local (npm run dev + vercel dev),
# et renseignez les mêmes valeurs dans Vercel > Project Settings > Environment Variables
# pour la production.

# Chaîne de connexion MongoDB (voir README, étape 1). Important : contrairement aux
# variables VITE_*, celle-ci n'a PAS le préfixe VITE_ — elle ne doit jamais être envoyée
# au navigateur. Utilisée uniquement par la fonction serveur dans api/kv.js.
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Jeton d'application qui protège l'API (voir README, "Sécurité"). Générez une longue
# chaîne aléatoire (ex. avec https://www.uuidgenerator.net, ou en tapant n'importe quel
# texte long et imprévisible) et mettez EXACTEMENT LA MÊME VALEUR dans les deux variables
# ci-dessous — l'une est lue côté serveur, l'autre est nécessaire côté navigateur.
APP_TOKEN=remplacez-par-une-longue-chaine-aleatoire-secrete
VITE_APP_TOKEN=remplacez-par-la-meme-longue-chaine-aleatoire-secrete
