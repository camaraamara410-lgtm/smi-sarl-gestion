# Copiez ce fichier en ".env" pour le développement local (vercel dev), et mettez les mêmes
# valeurs dans Vercel > Project Settings > Environment Variables pour la production.
# Aucune de ces variables n'a le préfixe VITE_ : elles restent côté serveur, jamais
# envoyées au navigateur.

# Chaîne de connexion MongoDB Atlas.
MONGODB_URI=mongodb+srv://utilisateur:motdepasse@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# Clé secrète qui signe les sessions de connexion. Longue chaîne aléatoire (40 caractères
# ou plus). La changer déconnecte tous les utilisateurs.
SESSION_SECRET=remplacez-par-une-longue-chaine-aleatoire

# Mot de passe de l'espace propriétaire (adresse de l'appli + #proprietaire).
# 10 caractères minimum.
SUPERADMIN_PASSWORD=remplacez-par-un-mot-de-passe-solide

# Société historique dont les données existaient avant le passage en multi-sociétés.
# Elle est créée automatiquement à sa première connexion et garde ses données.
LEGACY_TENANT_CODE=smi
LEGACY_TENANT_NAME=SMI SARL
